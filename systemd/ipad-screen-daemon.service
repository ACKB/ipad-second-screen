[Unit]
Description=Demonio de pantalla virtual automática para iPad en Sunshine (Wayland)
After=graphical-session.target app-dev.lizardbyte.app.Sunshine.service
Wants=app-dev.lizardbyte.app.Sunshine.service

[Service]
Type=simple
ExecStart=%h/.local/bin/ipad-screen-daemon.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
